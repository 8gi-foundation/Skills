function renderValueSlide(s: VSlide, i: number, total: number, date: string): string {
  const p: string[] = []
  p.push(`<div class="in">`)
  // In the flow, directly above the kicker: act bar, kicker, headline, support
  // is one composed unit with one vertical rhythm. Pinned to the frame corner it
  // was a stranded mark with three hundred pixels of nothing under it.
  p.push(`  <div class="acts" aria-hidden="true">` +
    [1, 2, 3].map((a) => `<i class="${a === s.act ? "on" : ""}"></i>`).join("") + `</div>`)
  p.push(`  <div class="kick">${esc(s.kicker)}</div>`)
  // The type adapts so the SENTENCE stays whole. A claim that needs thirteen
  // words gets thirteen words at a smaller size; it is never amputated to fit a
  // size. Two tidy lines of a real sentence beat one line of a fragment.
  const tag = s.kind === "title" ? "h1" : "h2"
  const hw = words(s.headline)
  // A verdict word IS the colour. Leaving it white was the same class of bug as
  // the positional green: a slide that states a status without showing it.
  const cls = [s.unsetHeadline ? "un" : s.kind === "verdict" ? "tn" : "",
    hw >= 13 ? "s3" : hw >= 9 ? "s2" : ""].filter(Boolean).join(" ")
  p.push(`  <${tag}${cls ? ` class="${cls}"` : ""}>${inline(s.headline)}</${tag}>`)

  if (s.stats?.length) {
    p.push(`  <div class="stats">` + s.stats.map((st) =>
      `<div class="stat"><div class="big${st.big.length > 9 ? " sm" : ""}">${inline(st.big)}</div>` +
      `<div class="lab">${inline(st.lab)}</div>` +
      (st.sub ? `<div class="sub">${inline(st.sub)}</div>` : ``) + `</div>`).join("") + `</div>`)
  }
  if (s.rows?.length) {
    p.push(`  <div class="rows">` + s.rows.map((r) =>
      `<div class="row ${r.done ? "done" : "left"}"><span class="dot"></span>` +
      `<span class="txt">${inline(r.text)}</span>` +
      `<span class="st">${r.done ? "done" : "left"}</span></div>`).join("") + `</div>`)
  }
  if (s.lines.length) {
    p.push(`  <div class="sup">` + s.lines.map((l) =>
      `<p${l.unset ? ` class="un"` : ""}>${inline(l.text)}</p>`).join("") + `</div>`)
  }
  // Screen readers get the spoken line; the renderer never sees it.
  p.push(`  <p class="sr">${esc(s.narration)}</p>`)
  p.push(`</div>`)

  if (s.record?.length) {
    p.push(`<div class="rec">` + s.record.map(([k, v]) =>
      `<div><div class="k">${esc(k)}</div><div class="v">${esc(tighten(v, 9))}</div></div>`).join("") + `</div>`)
  }
  if (i === 0) p.push(`<div class="date">${esc(date)}</div>`)
  p.push(`<div class="pg">${String(i + 1).padStart(2, "0")} / ${String(total).padStart(2, "0")}</div>`)
  return p.join("\n    ")
}

function renderValueDeck(slides: VSlide[], voice: string, docTitle: string): string {
  const date = new Date().toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long", year: "numeric" })
  const body = slides.map((s, i) =>
    `<div class="slide ${s.tone}" data-slide="${i}" data-voice="${esc(voice)}" ` +
    `data-voiceover="${esc(s.narration).replace(/\n/g, " ")}">\n    ` +
    renderValueSlide(s, i, slides.length, date) + `\n</div>`).join("\n\n")

  return `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>${esc(docTitle)}</title>
<style>${VALUE_CSS}</style>
</head>
<body>

${body}

<script>
(function () {
  var slides = document.querySelectorAll('.slide'); var i = 0;
  function show(n) { i = Math.max(0, Math.min(slides.length - 1, n));
    slides.forEach(function (el, idx) { el.classList.toggle('active', idx === i); }); }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowRight' || e.key === ' ') show(i + 1);
    if (e.key === 'ArrowLeft') show(i - 1); });
  function fromHash() { var m = (location.hash.match(/slide=(\\d+)/) || [])[1];
    show(m == null ? 0 : +m); }
  window.addEventListener('hashchange', fromHash);
  fromHash();
})();
</script>
</body>
</html>
`
}

/**
 * THE VALUE GATE. The structural gate below asks "is this a deck at all". This
 * one asks "is there a value story in it". Eight slides of "Not stated" is a
 * worse artifact than no deck, and shipping one would train James to ignore the
 * format. Four of the eight slots must carry something real.
 */
const VALUE_MIN_FIELDS = 4
function valueGate(v: SessionValue): { pass: boolean; filled: number; reason: string } {
  const slots = [
    !!(v.headline || v.value), !!v.jtbd, v.improvement.length > 0, !!v.learned,
    !!v.skill, v.regression.state !== "unverified", !!(v.goal || v.remaining.length), !!v.ask,
  ]
  const filled = slots.filter(Boolean).length
  return filled >= VALUE_MIN_FIELDS
    ? { pass: true, filled, reason: `${filled}/8 value slots stated` }
    : { pass: false, filled, reason: `only ${filled}/8 value slots stated (need ${VALUE_MIN_FIELDS}) - the response did not say what it was worth` }
}

/**
 * THE NARRATOR. Declared, never inferred - a constant, not a function of the
 * content, exactly as the Voice Contract requires.
 *
 * It is Samantha, 8PO, and deliberately not Rishi and not me. The complaint was
 * that these decks read as engineering, and 8TO's register IS the engineering
 * register in this house; James has heard Rishi on every merge deck today, so
 * the change of voice is itself the signal that this is a different kind of
 * report. 8PO owns the content model these slides are built from, so the words
 * are hers and the voice should be too. And 8DO narrating a deck 8DO designed
 * would make the deck an object about its own design.
 *
 * The officer who did the WORK still appears, on screen, in the record strip.
 */
const VALUE_NARRATOR: Officer = "Samantha"

// ------------------------------------------------------------------ gate
export interface Verdict { pass: boolean; reason: string; slides: number; chars: number; signals: string[] }

/**
 * THE GATE. Chosen by measuring every turn-final response this machine produced
 * on 9 August 2026: 600 unique responses across ~20 sessions, median 1025 chars.
 *
 *   no gate                                        600 decks/day  (absurd)
 *   >=1200 chars + any structure                   264 decks/day  (noise)
 *   >=2500 chars + strong structure                 25 decks/day  (this gate)
 *   + the hook's rate policy on top                  6 decks/day  (shippable)
 *
 * The floor is deliberately above the point where a Telegram message would do
 * the job. A response under 2500 characters is a message, not a deck. A
 * response with two headings and no numbered points has no acts to cut on.
 * A one-line reply cannot reach any of these and never will.
 */
/**
 * Revised 2026-08-09 after the gate refused a Phase 1 milestone report.
 *
 * Two blind spots, both mine rather than the gate's:
 *   - House style leads a section with a BOLD PHRASE, not a markdown heading.
 *     Counting only `#` scored that report at zero structure.
 *   - A status table is structure too. It is often the densest part.
 *
 * The floor moved 2500 -> 1800 because a milestone written tightly lands
 * around 1900 chars, and compressing an eleven-PR merge into one screen is
 * good writing, not a reason to withhold the deck. The hook's rate policy
 * (1 per 25 min, 6 per day) remains the real ceiling on volume.
 */
const MIN_CHARS = 1800
const MIN_CONTENT_SLIDES = 6

function gate(src: string, slides: Slide[], mode: "extractive" | "value" = "extractive"): Verdict {
  const chars = src.trim().length
  const signals: string[] = []
  const signoff = /^\s*SIGN-OFF:/m.test(src) || /^\s{2,}VOICE:\s*say/m.test(src)
  const numbered = (src.match(/^\s*(?:\d+[.)]|\*\*\d+[.)])\s+\S/gm) || []).length
  const heads = (src.match(/^#{1,3}\s+\S/gm) || []).length
  const boldLeads = (src.match(/^\*\*[^*\n]{3,90}\*\*/gm) || []).length
  const tables = (src.match(/^\|.+\|$/gm) || []).length >= 3 ? 1 : 0
  if (signoff) signals.push("sign-off")
  if (numbered) signals.push(`${numbered} numbered points`)
  if (heads) signals.push(`${heads} headings`)
  if (boldLeads) signals.push(`${boldLeads} bold leads`)
  if (tables) signals.push("table")
  const contentSlides = slides.filter((s) => !s.big).length

  const structure = heads + boldLeads + tables
  const strong = structure >= 3 || numbered >= 5 || (signoff && structure >= 2)
  const bail = (reason: string): Verdict => ({ pass: false, reason, slides: slides.length, chars, signals })

  if (chars < MIN_CHARS) return bail(`too short (${chars} < ${MIN_CHARS} chars) - a message, not a deck`)
  if (!strong) return bail(`weak structure (${heads} headings, ${boldLeads} bold leads, ${numbered} numbered, sign-off=${signoff}) - nothing to cut acts on`)
  // The slide-count floor is an extractive concern. The value spine is always
  // eight slides, so counting the extractive build there would reject a deck on
  // the shape of a renderer it is not using. The value gate is the real floor.
  if (mode === "extractive" && contentSlides < MIN_CONTENT_SLIDES) {
    return bail(`only ${contentSlides} content slides (need ${MIN_CONTENT_SLIDES})`)
  }
  return { pass: true, reason: `${signals.join(", ")}; ${slides.length} slides`, slides: slides.length, chars, signals }
}

// -------------------------------------------------------------- delivery
/**
 * ~/.claude/.env WINS over the ambient shell environment.
 *
 * Measured 2026-08-09: this machine's shell exports a TELEGRAM_BOT_TOKEN that
 * differs from the one in ~/.claude/.env (same chat id). Preferring the
 * environment sent the first real deck through the wrong bot, which failed
 * silently and fell back to a plain document. send-telegram-document has
 * always had it right - it does `set -a; . ~/.claude/.env`, so the file wins.
 * The file is the declared credential; the environment is drift.
 * Literal fallbacks remain banned.
 */
function readEnvVar(name: string): string | null {
  try {
    const env = readFileSync(ENV_FILE, "utf-8")
    const m = env.match(new RegExp(`^${name}=(.*)$`, "m"))
    if (m && m[1].trim()) return m[1].trim().replace(/^["']|["']$/g, "")
  } catch { /* no env file - fall through to the environment */ }
  return process.env[name] || null
}

const QUIET_START = 21, QUIET_END = 8.5
function inQuietHours(now: Date = new Date()): boolean {
  const h = now.getHours() + now.getMinutes() / 60
  return h >= QUIET_START || h < QUIET_END
}

/**
 * Telegram sendVideo so it plays inline with a thumbnail. James only ever
 * receives this on his own chat id from ~/.claude/.env - there is no
 * recipient parameter and no other target anywhere in this file.
 */
async function deliver(mp4: string, caption: string, quiet: boolean): Promise<string> {
  // Flow mode (opt-in breakpoint deferral, Resonant Flow Wave 1): when
  // ~/.8gent/flow/mode is "on", non-urgent decks queue to ~/.8gent/flow/queue
  // and land with the next digest instead of pinging mid-hyperfocus.
  // flow-mode maybe-defer COPIES the mp4 into the queue and exits 0 only when
  // safely queued; Blocked/Failed captions and any error exit 1 -> we deliver
  // normally. Classification lives in flow-mode (single source, no mirror).
  try {
    const flowBin = join(HOME, ".claude/bin/flow-mode")
    if (!process.env.FLOW_BYPASS && existsSync(flowBin) &&
        readFileSync(join(HOME, ".8gent/flow/mode"), "utf-8").trim() === "on") {
      const fr = spawnSync(flowBin, ["maybe-defer", "--video", mp4, "--body", caption], { encoding: "utf-8" })
      if (fr.status === 0) return "deferred to flow queue"
    }
  } catch { /* no mode file or flow-mode error -> flow off, deliver normally */ }
  const token = readEnvVar("TELEGRAM_BOT_TOKEN")
  const chatId = readEnvVar("TELEGRAM_CHAT_ID")
  if (!token || !chatId) return "no credentials, not sent"
  let why = ""
  try {
    const form = new FormData()
    form.append("chat_id", chatId)
    form.append("caption", caption)
    form.append("supports_streaming", "true")
    if (quiet) form.append("disable_notification", "true")
    form.append("video", new Blob([readFileSync(mp4)], { type: "video/mp4" }), mp4.split("/").pop()!)
    const r = await fetch(`https://api.telegram.org/bot${token}/sendVideo`, { method: "POST", body: form })
    const j: any = await r.json()
    if (j?.ok) return quiet ? "sent as video (silent, quiet hours)" : "sent as video"
    why = `sendVideo ${r.status}: ${j?.description || "unknown"}`
  } catch (e: any) {
    why = `sendVideo threw: ${e?.message || e}`
  }
  // Never swallow the reason - a silent fallback is how the wrong-token bug hid.
  log(`deliver fallback: ${why}`)
  const r = spawnSync(SEND_DOC, [mp4, caption], { encoding: "utf-8" })
  return r.status === 0 ? `sent as document (${why})` : `send failed: ${why}; ${(r.stderr || "").trim()}`
}

function log(msg: string) {
  try { appendFileSync(LOG, `${new Date().toISOString()} ${msg}\n`) } catch { /* non-fatal */ }
}

// ------------------------------------------------------------------ main
function deriveTitle(src: string, completed: string | null): string {
  const h1 = src.match(/^#\s+(.+)$/m)
  if (h1) return h1[1].trim().replace(/[*`]/g, "")
  if (completed) {
    const first = completed.split(/(?<=[.!?])\s/)[0]
    if (first && first.length > 8) return clip(first.replace(/[*`]/g, ""), 72)
  }
  const h2 = src.match(/^##\s+(.+)$/m)
  if (h2) return h2[1].trim().replace(/[*`]/g, "")
  return "Session report"
}

function extractCompleted(src: string): string | null {
  const m = src.match(/🎯\s*COMPLETED[:\s]*(.+?)(?:\n\n|$)/is)
  return m ? m[1].trim().replace(/\s+/g, " ").slice(0, 300) : null
}

const slug = (s: string) =>
  s.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "").slice(0, 42) || "response"

// -------------------------------------------------------------- self test
function selfTest(): number {
  let fail = 0
  const check = (name: string, got: unknown, want: unknown) => {
    const ok = String(got) === String(want)
    if (!ok) fail++
    console.log(`  ${ok ? "ok  " : "FAIL"}  ${name}${ok ? "" : `\n        got:  ${got}\n        want: ${want}`}`)
  }

  console.log("\n[1] Narration never reads symbols, paths or markdown aloud")
  check("arrow", speakable("build -> deploy"), "build to deploy.")
  check("issue number", speakable("PR #551 is open"), "PR number 551 is open.")
  check("em dash banned", speakable("It works — mostly"), "It works, mostly.")
  check("path collapses", speakable("see /Users/alex/.claude/bin/response-to-deck now"),
    "see response to deck now.")
  check("bold markers gone", speakable("**Done.** All `tests` pass"), "Done. All tests pass.")
  check("percent", speakable("49% of every turn"), "49 percent of every turn.")
  check("url dropped", speakable("live at https://8gi.org/x today"), "live at today.")
  check("trailing colon", speakable("From the commits:"), "From the commits.")

  console.log("\n[2] No em dash reaches a slide")
  check("inline strips em dash", inline("a — b"), "a - b")
  check("truncation leaks nothing", inline(clip("**unscoped triage loop that runs long", 20)), "unscoped triage…")

  console.log("\n[3] Quiet hours 21:00-08:30")
  const at = (h: number, m = 0) => { const d = new Date(); d.setHours(h, m, 0, 0); return d }
  check("20:59 loud", inQuietHours(at(20, 59)), false)
  check("21:00 quiet", inQuietHours(at(21, 0)), true)
  check("03:00 quiet", inQuietHours(at(3, 0)), true)
  check("08:29 quiet", inQuietHours(at(8, 29)), true)
  check("08:30 loud", inQuietHours(at(8, 30)), false)

  console.log("\n[4] The gate rejects anything that is really a message")
  const verdictFor = (s: string) => gate(s, buildSlides(parseMarkdown(s), "t", null))
  check("one-liner", verdictFor("Done.").pass, false)
  check("short sign-off", verdictFor("Shipped it.\n\nSIGN-OFF:\n  VOICE: say -v Rishi \"x\"\n  COMMIT: abc").pass, false)
  check("long but shapeless", verdictFor("A sentence with no structure at all. ".repeat(120)).pass, false)
  const body = "Something measured and specific happened here, with a number attached, " +
    "and a consequence that changes what happens next for the person reading it. "
  const section = (i: number) => `## Section ${i}\n\n**Point ${i}** ${body.repeat(3)}\n`
  const rich = "# Title\n\nOpening paragraph with real substance in it.\n\n" +
    [1, 2, 3, 4, 5, 6].map(section).join("\n")
  check("structured and long", verdictFor(rich).pass, true)
  // Six sections clear the floor; four do not, even when long enough. The
  // floor is deliberate: a five-slide deck is a message with three minutes
  // of rendering overhead bolted on.
  const thin = "# Title\n\nOpening paragraph.\n\n" +
    [1, 2, 3, 4].map((i) => `## Section ${i}\n\n**Point ${i}** ${body.repeat(6)}\n`).join("\n")
  check("thin structure, still long", verdictFor(thin).pass, false)

  console.log("\n[5] Officer voices stay distinct and installed")
  const styles = new Set(Object.values(DECK_VOICE_BY_OFFICER))
  check("8 distinct deck voices", styles.size, 8)
  const have = spawnSync("say", ["-v", "?"], { encoding: "utf-8" }).stdout || ""
  const installed = new Set(have.split("\n").map((l) => l.trim().split(/\s+/)[0]).filter(Boolean))
  for (const [off, v] of Object.entries(DECK_VOICE_BY_OFFICER)) check(`${off} -> ${v} installed`, installed.has(v), true)
  check("declared officer wins", pickOfficer("VOICE: say -v Moira \"x\""), "Moira")
  check("no declaration -> narrator", pickOfficer("no voice line here"), "James")

  console.log("\n[6] Value deck: the spine is fixed and the caps are enforced, not trusted")
  const fat = (n: number) => Array.from({ length: n }, (_, i) => `word${i}`).join(" ") + "."
  const overfed: SessionValue = normaliseValue({
    headline: fat(40), value: fat(60), jtbd: fat(60), skill: fat(60), learned: fat(60),
    regression: { state: "found", note: fat(60) },
    improvement: [1, 2, 3, 4, 5, 6].map((i) => ({ metric: fat(20), before: `${i}`, after: `${i * 2}` })),
    goal: fat(60), remaining: [1, 2, 3, 4, 5, 6, 7, 8].map((i) => ({ text: fat(30), done: false })),
    evidence: [1, 2, 3, 4, 5].map((i) => ({ label: `E${i}`, value: fat(20) })),
    ask: fat(60),
  })
  const fatSpine = buildValueSpine(overfed, "Samantha", "Rishi")
  check("always exactly 8 slides", fatSpine.length, 8)
  check("headline <= 15 words, ask <= 20", fatSpine.every((s) =>
    words(s.headline) <= (s.kind === "ask" ? CAP.askWords : CAP.headlineWords)), true)
  check("<= 3 support lines", fatSpine.every((s) => s.lines.length <= CAP.lines), true)
  check("the ask is never cut into an instruction",
    buildValueSpine(normaliseValue({ ask: "Restart the bridge to make it live, or leave it until you are done talking to it?" }),
      "Samantha", "James")[7].headline,
    "Restart the bridge to make it live, or leave it until you are done talking to it?")
  check("<= 42 words on a slide", fatSpine.every((s) =>
    words(s.headline) + s.lines.reduce((a, l) => a + words(l.text), 0) <= CAP.slideWords + CAP.askWords), true)
  check("<= 46 words of narration", fatSpine.every((s) => words(s.narration) <= CAP.narrationWords), true)
  check("<= 3 stats", (fatSpine[2].stats || []).length <= CAP.stats, true)
  check("<= 4 ladder rows", (fatSpine[6].rows || []).length <= CAP.ladderRows, true)
  const fatHtml = renderValueDeck(fatSpine, "Samantha", "t")
  check("no ellipsis reaches a value slide", /…/.test(fatHtml), false)
  check("no em dash reaches a value slide", /[—–]/.test(fatHtml), false)
  check("no banned hue 270-350 in the palette", /#(9|A|B|C|D)[0-9A-F]{1}[0-9A-F]{2}(F|E|D)[0-9A-F]/i.test(VALUE_CSS) &&
    /purple|violet|magenta|#8B5CF6|#A855F7|#D946EF/i.test(VALUE_CSS), false)

  console.log("\n[7] Value deck: an empty run renders honestly, never a guess")
  const empty = buildValueSpine(normaliseValue({}), "Samantha", "James")
  check("still 8 slides", empty.length, 8)
  check("no field invented", empty.every((s) => !/\b(probably|likely|approximately|roughly)\b/i.test(
    s.headline + s.lines.map((l) => l.text).join(" ") + s.narration)), true)
  check("regression defaults to NOT VERIFIED", empty[5].headline, "NOT VERIFIED")
  check("unverified is amber, not green", empty[5].tone, "watch")
  check("no measurement says so", empty[2].headline, "Not measured")
  check("empty run fails the value gate", valueGate(normaliseValue({})).pass, false)
  check("colour is never the only signal", renderValueDeck(empty, "Samantha", "t").includes("NOT VERIFIED"), true)

  console.log("\n[8] Value deck: semantic colour, and the narrator is declared")
  const good = buildValueSpine(normaliseValue({ regression: { state: "none", note: null } }), "Samantha", "James")
  check("checked no-regression is green", good[5].tone, "good")
  const bad = buildValueSpine(normaliseValue({ regression: { state: "found", note: "Helm pane lost its grouping." } }), "Samantha", "James")
  check("a real regression is red, never green", bad[5].tone, "alert")
  check("alarming slide cannot render green", bad[5].tone === "good", false)
  check("narrator is a constant, not inferred", VALUE_NARRATOR, "Samantha")
  check("narrator voice is installed", installed.has(DECK_VOICE_BY_OFFICER[VALUE_NARRATOR]), true)
  check("acts are 1,1,1,2,2,2,3,3", fatSpine.map((s) => s.act).join(""), "11122233")
  check("the last slide is the ask", fatSpine[7].kind, "ask")

  console.log("\n[9] Fallback content model lifts verbatim and never computes")
  const fb = fallbackValue("Latency went from 820ms to 310ms in the router.\n\n**Learned:** the cap was a guess.\n")
  check("lifts a stated before/after", `${fb.improvement[0]?.before} to ${fb.improvement[0]?.after}`, "820ms to 310ms")
  check("lifts a labelled lesson", fb.learned, "the cap was a guess.")
  check("does not invent a skill", fb.skill, null)
  check("passing tests never imply no regression",
    fallbackValue("All 263 tests pass and the build is green.").regression.state, "unverified")
  check("an explicit statement does", fallbackValue("No regressions: the old path is untouched.").regression.state, "none")

  console.log(fail === 0 ? "\nRESPONSE-TO-DECK: PASS - all checks green.\n" : `\nRESPONSE-TO-DECK: FAIL - ${fail} check(s).\n`)
  return fail
}

async function main() {
  const argv = process.argv.slice(2)
  const flag = (n: string) => argv.includes(n)
  const val = (n: string) => { const i = argv.indexOf(n); return i >= 0 ? argv[i + 1] : undefined }

  if (flag("--selftest")) process.exit(selfTest() === 0 ? 0 : 1)

  let src = ""
  const file = val("--file")
  if (file) src = readFileSync(file, "utf-8")
  else src = await Bun.stdin.text()
  if (!src.trim()) { console.error("response-to-deck: empty input"); process.exit(2) }

  const completed = extractCompleted(src)
  const docTitle = val("--title") || deriveTitle(src, completed)
  const officer = pickOfficer(src)
  const blocks = parseMarkdown(src)
  const slides = buildSlides(blocks, docTitle, completed)

  // The value deck is the default. `--extractive` restores the old renderer,
  // which is still the right tool when the response IS the artifact (a plan, a
  // validation record) rather than a report of what a run was worth.
  const useValue = !flag("--extractive")
  const verdict = gate(src, slides, useValue ? "value" : "extractive")
  const nOverride = val("--narrator")
  const narrator: Officer = (nOverride && nOverride in DECK_VOICE_BY_OFFICER)
    ? nOverride as Officer : VALUE_NARRATOR
  const loaded = useValue ? await loadSessionValue(src) : null
  const vGate = loaded ? valueGate(loaded.v) : null
  const vSlides = loaded ? buildValueSpine(loaded.v, narrator === "James" ? "AI James" : narrator, officer) : null

  if (flag("--gate-only")) {
    console.log(JSON.stringify(vGate ? { ...verdict, value: vGate, source: loaded!.from } : verdict))
    process.exit(verdict.pass && (!vGate || vGate.pass) ? 0 : 1)
  }
  if (flag("--plan")) {
    console.log(JSON.stringify(vSlides
      ? { mode: "value", title: docTitle, narrator, workedBy: officer, verdict, value: vGate,
          source: loaded!.from, model: loaded!.v,
          slides: vSlides.map((s, i) => ({ i, kind: s.kind, act: s.act, kicker: s.kicker,
            headline: s.headline, tone: s.tone, lines: s.lines.map((l) => l.text),
            stats: s.stats, rows: s.rows, record: s.record, narration: s.narration })) }
      : { mode: "extractive", title: docTitle, officer, verdict, slides: slides.map((s, i) => ({
          i, kicker: s.kicker, title: s.title, lede: s.lede ? clip(s.lede, 60) : undefined,
          points: s.points.length, bullets: s.bullets.length, code: !!s.code, table: !!s.table,
          manifest: !!s.manifest, narration: s.narration })) }, null, 2))
    process.exit(0)
  }
  if (!verdict.pass && !flag("--force")) {
    console.error(`response-to-deck: gate failed - ${verdict.reason}`)
    process.exit(1)
  }
  if (vGate && !vGate.pass && !flag("--force")) {
    console.error(`response-to-deck: value gate failed - ${vGate.reason}`)
    process.exit(1)
  }

  mkdirSync(CREATIVE, { recursive: true })
  const stamp = new Date().toISOString().slice(0, 10)
  const name = val("--out") || `auto-${slug(docTitle)}-${stamp}-${Date.now().toString(36).slice(-4)}`
  const htmlPath = join(CREATIVE, `${name}.html`)
  writeFileSync(htmlPath, vSlides
    ? renderValueDeck(vSlides, DECK_VOICE_BY_OFFICER[narrator], docTitle)
    : renderDeck(slides, DECK_VOICE_BY_OFFICER[officer], docTitle, officer))
  log(vSlides
    ? `render ${name} mode=value slides=${vSlides.length} narrator=${narrator} workedBy=${officer} value="${vGate!.reason}" src=${loaded!.from}`
    : `render ${name} mode=extractive slides=${slides.length} officer=${officer} gate="${verdict.reason}"`)
  if (flag("--html-only")) { console.log(htmlPath); process.exit(0) }

  const r = spawnSync("python3", [DECK2VIDEO, htmlPath, "--out", name, "--tts", "supertonic"],
    { encoding: "utf-8", timeout: 15 * 60 * 1000 })
  const mp4 = join(CREATIVE, `${name}.mp4`)
  if (r.status !== 0 || !existsSync(mp4)) {
    log(`FAIL ${name}: ${(r.stderr || "").slice(-400)}`)
    console.error(`response-to-deck: render failed\n${r.stderr || ""}`)
    process.exit(3)
  }
  console.log(mp4)

  // Put it on his screen. Adopted 17 Aug 2026 at James's request: "as default
  // in the stop hook just always open up the summary and what's next video".
  //
  // Telegram delivery is the away channel and the durable record; it is not
  // the at-machine one. A deck that only ever landed in a chat he had to go
  // find is a deck he did not watch, which defeats the entire reason this
  // renderer exists. The sign-off protocol already treats an unopened file
  // deliverable as invalid, so this closes that by construction rather than by
  // remembering.
  //
  // `--no-open` exists for batch and CI runs that must not steal focus.
  if (!flag("--no-open")) {
    const o = spawnSync("open", [mp4], { encoding: "utf-8" })
    log(o.status === 0 ? `open ${name}: ok` : `open ${name}: failed ${(o.stderr || "").slice(-200)}`)
  }

  if (!flag("--no-send")) {
    const quiet = inQuietHours()
    const caption = `${docTitle} - ${(vSlides ?? slides).length} slides, narrated`
    const status = await deliver(mp4, caption, quiet)
    log(`deliver ${name}: ${status}`)
    console.log(status)
  }
}

if (import.meta.main) main()
