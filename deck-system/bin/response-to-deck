#!/usr/bin/env bun
/**
 * response-to-deck - turn a markdown response into a narrated MP4.
 *
 * James does not read walls of text. He watches decks. This renders an
 * arbitrary markdown response into the 8GI deck convention
 * (`<div class="slide" data-slide="N" data-voice="X" data-voiceover="...">`)
 * and hands it to the deck pipeline that already works:
 *
 *   deck2video.py <deck.html> --out NAME --tts supertonic
 *
 * Structure maps to slides:
 *   h1/h2/h3        -> a slide title (h3 keeps its parent h2 as the kicker)
 *   **Bold lead:**  -> a numbered point with a subtitle
 *   - bullet        -> a bulleted line
 *   | table |       -> a table slide
 *   ```code```      -> a code slide
 *   SIGN-OFF:       -> the closing manifest slide
 *
 * Narration per slide is that slide's own prose, punctuation-normalised so the
 * voice never reads "->" or "#551" or a 90-character absolute path aloud.
 *
 * Usage:
 *   response-to-deck --file resp.md [--out NAME] [--title "..."] [--no-send] [--no-open]
 *   cat resp.md | response-to-deck
 *   response-to-deck --file resp.md --gate-only    # exit 0 = earns a deck
 *   response-to-deck --file resp.md --plan         # print the slide plan, render nothing
 *
 * The finished MP4 is opened on this machine by default, because a deck he has
 * to go looking for is a deck he does not watch. Pass --no-open for batch runs.
 *
 * Everything is local. Narration is Supertonic on this machine. No cloud key.
 */

import { spawnSync, spawn } from "child_process"
import { readFileSync, writeFileSync, existsSync, mkdirSync, appendFileSync } from "fs"
import { join } from "path"

const HOME = process.env.HOME || ""
const CREATIVE = join(HOME, ".8gent/creative")
const DECK2VIDEO = process.env.DECK2VIDEO || join(HOME, ".claude/bin/deck2video.py")
const SEND_DOC = join(HOME, ".claude/bin/send-telegram-document")
const ENV_FILE = join(HOME, ".claude/.env")
const LOG = join(HOME, ".claude/hooks/.response-deck.log")

// ---------------------------------------------------------------- voices
// Officer -> a voice name deck2video maps to a distinct Supertonic style.
// All eight are genuinely installed macOS voices, so the `say` fallback inside
// deck2video also stays distinct. Mirrors the Voice Contract; does not own it.
type Officer = "James" | "Rishi" | "Samantha" | "Moira" | "Karen" | "Luis" | "Zara" | "Solomon"

const DECK_VOICE_BY_OFFICER: Record<Officer, string> = {
  James: "Daniel",    // Supertonic M2
  Rishi: "Rishi",     // M3
  Samantha: "Samantha", // F1
  Moira: "Moira",     // F2
  Karen: "Karen",     // F3
  Zara: "Tessa",      // F4
  Luis: "Reed",       // M4
  Solomon: "Grandpa", // M5
}

const LEGACY_VOICE_ALIASES: Record<string, Officer> = {
  Ava: "James", Zarvox: "Zara", Alex: "Solomon", Diego: "Luis",
  Oliver: "Rishi", Tessa: "Zara", Albert: "Solomon", Xander: "Luis",
}

/** Same declared-identity rule as the Voice Contract: never inferred. */
function pickOfficer(response: string): Officer {
  const m = response.match(/VOICE:\s*say\s+-v\s+(\w+)/) ?? response.match(/\bVOICE:\s*(\w+)/)
  if (m) {
    const cap = m[1].charAt(0).toUpperCase() + m[1].slice(1).toLowerCase()
    if (cap in DECK_VOICE_BY_OFFICER) return cap as Officer
    if (cap in LEGACY_VOICE_ALIASES) return LEGACY_VOICE_ALIASES[cap]
  }
  return "James"
}

// ------------------------------------------------------------- narration
/**
 * Turn written markdown into something a TTS voice can say without embarrassing
 * itself. The failure this exists to prevent: the voice reading "dash dash"
 * for a rule, "hash five five one" for an issue, or a full absolute path
 * one character at a time.
 */
function speakable(raw: string): string {
  let t = raw

  // Fenced/inline code and links first, before symbol substitution.
  t = t.replace(/```[\s\S]*?```/g, " ")
  t = t.replace(/`([^`]*)`/g, "$1")
  t = t.replace(/!\[[^\]]*\]\([^)]*\)/g, " ")
  t = t.replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
  t = t.replace(/https?:\/\/\S+/g, " ")

  // Absolute and relative paths: say the last segment as words, not the tree.
  t = t.replace(/(?:~|\.{0,2})?\/[\w.\-\/]{4,}/g, (p) => {
    const seg = p.split("/").filter(Boolean).pop() || ""
    return " " + seg.replace(/\.[a-z0-9]{1,4}$/i, "").replace(/[-_.]+/g, " ") + " "
  })

  // Markdown emphasis and structure markers.
  t = t.replace(/^\s{0,3}#{1,6}\s+/gm, "")
  t = t.replace(/\*\*([^*]+)\*\*/g, "$1")
  t = t.replace(/(^|\s)\*([^*\n]+)\*(?=\s|$)/g, "$1$2")
  t = t.replace(/(^|\s)_([^_\n]+)_(?=\s|$)/g, "$1$2")
  t = t.replace(/^\s*[-*+]\s+/gm, "")
  t = t.replace(/^\s*>\s?/gm, "")

  // Symbols the voice must not read literally.
  t = t.replace(/[—–]/g, ", ")     // em/en dash -> comma (also the house rule)
  t = t.replace(/-{2,}/g, ", ")
  t = t.replace(/(->|=>|→)/g, " to ")
  t = t.replace(/#(\d+)/g, " number $1")
  t = t.replace(/(\d)\s*%/g, "$1 percent")
  t = t.replace(/\s&\s/g, " and ")
  t = t.replace(/\s\+\s/g, " plus ")
  t = t.replace(/\s=\s/g, " equals ")
  t = t.replace(/\s~\s?(\d)/g, " about $1")
  t = t.replace(/\s\|\s/g, ", ")
  t = t.replace(/\bv(\d+\.\d+[\d.]*)/g, "version $1")

  // Anything non-speech (emoji, box drawing, stray punctuation) goes.
  t = t.replace(/[^\x20-\x7E\n]/g, " ")
  t = t.replace(/[*_`~^|\\<>{}\[\]#@$]/g, " ")
  t = t.replace(/\s*\n\s*/g, ". ")
  t = t.replace(/\s{2,}/g, " ")
  t = t.replace(/\s+([.,;:!?])/g, "$1")
  t = t.replace(/\.{2,}/g, ".")
  t = t.replace(/:\s*\./g, ".")
  t = t.replace(/(\.\s*){2,}/g, ". ")
  t = t.replace(/,\s*\./g, ".")
  t = t.trim()

  t = t.replace(/[:;,]+$/, "")
  if (!t) return ""
  if (!/[.!?]$/.test(t)) t += "."
  return t
}

/** Cap narration so a slide never sits on screen for 40 seconds. */
function capNarration(t: string, max = 420): string {
  if (t.length <= max) return t
  const cut = t.slice(0, max)
  const lastStop = Math.max(cut.lastIndexOf(". "), cut.lastIndexOf("! "), cut.lastIndexOf("? "))
  return (lastStop > max * 0.5 ? cut.slice(0, lastStop + 1) : cut.replace(/\s\S*$/, "") + ".").trim()
}

// ------------------------------------------------------------ md parsing
type Block =
  | { k: "h"; level: number; text: string }
  | { k: "code"; lang: string; lines: string[] }
  | { k: "table"; head: string[]; rows: string[][] }
  | { k: "point"; lead: string; rest: string }
  | { k: "bullet"; text: string }
  | { k: "para"; text: string }
  | { k: "signoff"; fields: [string, string][] }

const SIGNOFF_KEYS = ["VOICE", "VALIDATE", "VISUAL", "COMMIT", "PUSHED", "ISSUE", "PR"]

function parseMarkdown(src: string): Block[] {
  const lines = src.replace(/\r/g, "").split("\n")
  const out: Block[] = []
  let i = 0
  let para: string[] = []

  const flushPara = () => {
    if (!para.length) return
    const text = para.join(" ").trim()
    para = []
    if (!text) return
    const lead = text.match(/^\*\*([^*]{2,80})\*\*[:.]?\s*(.*)$/s)
    if (lead) out.push({ k: "point", lead: lead[1].trim(), rest: lead[2].trim() })
    else out.push({ k: "para", text })
  }

  while (i < lines.length) {
    const ln = lines[i]

    // SIGN-OFF manifest
    if (/^\s*SIGN-OFF:\s*$/.test(ln) || /^\s*SIGN-OFF:/.test(ln)) {
      flushPara()
      const fields: [string, string][] = []
      i++
      while (i < lines.length) {
        const f = lines[i].match(/^\s{2,}([A-Z]+):\s*(.*)$/)
        if (f && SIGNOFF_KEYS.includes(f[1])) { fields.push([f[1], f[2].trim()]); i++; continue }
        if (/^\s*$/.test(lines[i]) && fields.length) { i++; continue }
        if (/^\s*```/.test(lines[i])) { i++; continue }
        break
      }
      if (fields.length) out.push({ k: "signoff", fields })
      continue
    }

    // fenced code
    const fence = ln.match(/^\s*```+\s*(\w*)/)
    if (fence) {
      flushPara()
      const lang = fence[1] || ""
      const body: string[] = []
      i++
      while (i < lines.length && !/^\s*```/.test(lines[i])) { body.push(lines[i]); i++ }
      i++
      // A fenced SIGN-OFF block is a manifest, not code.
      const joined = body.join("\n")
      if (/^\s*SIGN-OFF:/m.test(joined)) {
        const fields: [string, string][] = []
        for (const b of body) {
          const f = b.match(/^\s*([A-Z]+):\s*(.*)$/)
          if (f && SIGNOFF_KEYS.includes(f[1])) fields.push([f[1], f[2].trim()])
        }
        if (fields.length) { out.push({ k: "signoff", fields }); continue }
      }
      if (body.some((b) => b.trim())) out.push({ k: "code", lang, lines: body })
      continue
    }

    // heading
    const h = ln.match(/^(#{1,6})\s+(.+?)\s*#*$/)
    if (h) { flushPara(); out.push({ k: "h", level: h[1].length, text: h[2].trim() }); i++; continue }

    // horizontal rule
    if (/^\s*([-*_])\s*\1\s*\1[\s\-*_]*$/.test(ln)) { flushPara(); i++; continue }

    // table
    if (/^\s*\|.*\|\s*$/.test(ln) && i + 1 < lines.length && /^\s*\|[\s:|-]+\|\s*$/.test(lines[i + 1])) {
      flushPara()
      const cells = (r: string) => r.trim().replace(/^\||\|$/g, "").split("|").map((c) => c.trim())
      const head = cells(ln)
      i += 2
      const rows: string[][] = []
      while (i < lines.length && /^\s*\|.*\|\s*$/.test(lines[i])) { rows.push(cells(lines[i])); i++ }
      out.push({ k: "table", head, rows })
      continue
    }

    // list item
    const li = ln.match(/^\s{0,3}(?:[-*+]|\d+[.)])\s+(.+)$/)
    if (li) {
      flushPara()
      let text = li[1].trim()
      // absorb continuation lines
      while (i + 1 < lines.length && /^\s{2,}\S/.test(lines[i + 1]) && !/^\s{0,3}(?:[-*+]|\d+[.)])\s/.test(lines[i + 1])) {
        text += " " + lines[i + 1].trim(); i++
      }
      const lead = text.match(/^\*\*([^*]{2,80})\*\*[:.]?\s*(.*)$/s)
      if (lead) out.push({ k: "point", lead: lead[1].trim(), rest: lead[2].trim() })
      else out.push({ k: "bullet", text })
      i++
      continue
    }

    if (/^\s*$/.test(ln)) { flushPara(); i++; continue }
    para.push(ln.trim())
    i++
  }
  flushPara()
  return out
}

// ----------------------------------------------------------- slide model
interface Slide {
  kicker?: string
  kickerTone?: "" | "a" | "b" | "w"
  title: string
  big?: boolean
  cont?: boolean          // continuation of the previous slide's section
  lede?: string
  points: { n: number; t: string; s: string }[]
  bullets: string[]
  code?: { lines: string[] }
  table?: { head: string[]; rows: string[][] }
  manifest?: [string, string][]
  narration: string
  narrationSrc: string[]
}

const BUDGET = 10
const W = { lede: 3, point: 3, bullet: 2, code: 8, table: 8, manifest: 10 }

function newSlide(title: string, kicker?: string, tone: Slide["kickerTone"] = ""): Slide {
  return { title, kicker, kickerTone: tone, points: [], bullets: [], narration: "", narrationSrc: [] }
}

function weight(s: Slide): number {
  return (s.lede ? W.lede : 0) + s.points.length * W.point + s.bullets.length * W.bullet +
    (s.code ? W.code : 0) + (s.table ? W.table : 0) + (s.manifest ? W.manifest : 0)
}

function isEmpty(s: Slide): boolean {
  return !s.lede && !s.points.length && !s.bullets.length && !s.code && !s.table && !s.manifest
}

const TONES: Slide["kickerTone"][] = ["", "b", "a", "b"]

function buildSlides(blocks: Block[], docTitle: string, completedLine: string | null): Slide[] {
  const slides: Slide[] = []
  let cur: Slide | null = null
  let kicker = "Update"
  let pointNo = 0
  let sectionIdx = 0

  const push = () => { if (cur && !isEmpty(cur)) slides.push(cur); cur = null }
  const ensure = () => {
    if (!cur) { cur = newSlide(kicker, kicker, TONES[sectionIdx % TONES.length]); cur.title = kicker }
    return cur
  }
  const overflow = () => {
    if (!cur) return ensure()
    const c = cur
    push()
    cur = newSlide(c.title, c.kicker, c.kickerTone)
    cur.title = c.title
    cur.cont = true
    return cur
  }

  for (const b of blocks) {
    if (b.k === "h") {
      push()
      sectionIdx++
      if (b.level <= 2) { kicker = b.text; cur = newSlide(b.text, sectionLabel(sectionIdx), TONES[sectionIdx % TONES.length]) }
      else { cur = newSlide(b.text, kicker, TONES[sectionIdx % TONES.length]) }
      pointNo = 0
      continue
    }
    if (b.k === "signoff") { push(); const s = newSlide("Sign-off", "Chain of custody", "b"); s.manifest = b.fields; slides.push(s); continue }

    let s = ensure()
    const add = (w: number) => { if (weight(s) + w > BUDGET) s = overflow() }

    switch (b.k) {
      case "para": {
        add(W.lede)
        if (s.lede) { s.lede += " " + b.text } else { s.lede = b.text }
        s.narrationSrc.push(b.text)
        break
      }
      case "point": {
        add(W.point)
        pointNo++
        // The numbered circle already carries the number - do not print it twice.
        const lead = b.lead.replace(/^\s*(\d+)\s*[.):]\s*/, (_m, n) => { pointNo = parseInt(n, 10); return "" })
        s.points.push({ n: pointNo, t: lead || b.lead, s: b.rest })
        s.narrationSrc.push((lead || b.lead) + (b.rest ? ". " + b.rest : ""))
        break
      }
      case "bullet": {
        add(W.bullet)
        s.bullets.push(b.text)
        s.narrationSrc.push(b.text)
        break
      }
      case "code": {
        add(W.code)
        const kept = b.lines.filter((l) => l.trim())
        s.code = { lines: kept.slice(0, 12) }
        if (kept.length > 12) s.code.lines.push("...")
        // Plain-prose blocks (verdict lists, log lines, checklists) are worth
        // narrating. Real syntax is not - the voice would spell out braces.
        const wordy = kept.filter((l) => /^[\s\w.,:;'"()\/#%+-]+$/.test(l) && /[a-z]{3}/i.test(l))
        if (wordy.length >= 2 && wordy.length / kept.length > 0.6) {
          s.narrationSrc.push(wordy.slice(0, 4).join(". "))
        }
        break
      }
      case "table": {
        add(W.table)
        s.table = { head: b.head.slice(0, 4), rows: b.rows.slice(0, 6).map((r) => r.slice(0, 4)) }
        // Reading a grid aloud is useless. Read the row labels, which is what
        // the column of names actually is.
        const labels = b.rows.slice(0, 6).map((r) => r[0]).filter(Boolean)
        s.narrationSrc.push(labels.length
          ? `${b.head[0] || "Rows"}: ${labels.join(", ")}.`
          : `${b.rows.length} rows.`)
        break
      }
    }
  }
  push()

  // Title slide, always first, always the same shape. If it has to borrow the
  // opening paragraph, that paragraph is removed downstream so the deck does
  // not say the same sentence twice in the first ten seconds.
  const title = newSlide(docTitle, "8GI - Session report", "")
  title.big = true
  if (completedLine) {
    title.lede = completedLine
  } else if (slides[0] && slides[0].lede) {
    title.lede = clip(slides[0].lede, 240)
    if (slides[0].lede.length <= 260) {
      slides[0].narrationSrc = slides[0].narrationSrc.filter((x) => x !== slides[0].lede)
      slides[0].lede = undefined
      if (isEmpty(slides[0])) slides.shift()
    }
  }
  title.narrationSrc.push(docTitle, title.lede || "")
  slides.unshift(title)

  // Narration: prose first, title as the honest fallback when there is no prose.
  for (const s of slides) {
    let n = speakable(s.narrationSrc.filter(Boolean).join(". "))
    const t = speakable(s.title).replace(/\.$/, "")
    if (!n || n.length < 12) {
      n = s.code ? `${t}. The detail is on screen.`
        : s.table ? `${t}. The table is on screen.`
        : s.manifest ? "Sign off. The chain of custody is on screen."
        : t + "."
    } else if (!s.cont && t.length > 6 && !n.toLowerCase().startsWith(t.toLowerCase().slice(0, 18))) {
      n = t + ". " + n
    }
    s.narration = capNarration(n)
  }
  return slides
}

function sectionLabel(i: number): string {
  const labels = ["What happened", "The detail", "The evidence", "What is next", "Open points", "The record"]
  return labels[(i - 1) % labels.length]
}

// ------------------------------------------------------------------ html
const esc = (s: string) =>
  s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;").replace(/"/g, "&quot;")

/** Inline markdown -> styled spans. Keeps emphasis, never leaks raw markers. */
function inline(s: string): string {
  let t = esc(s)
  t = t.replace(/`([^`]+)`/g, '<code>$1</code>')
  t = t.replace(/\*\*([^*]+)\*\*/g, "<b>$1</b>")
  t = t.replace(/(^|[\s(])\*([^*\n]+)\*(?=[\s).,;:]|$)/g, "$1<i>$2</i>")
  t = t.replace(/\[([^\]]+)\]\([^)]*\)/g, "$1")
  t = t.replace(/\s*[—–]\s*/g, " - ")   // house rule: no em dashes, ever
  // Truncation can cut a string between its opening and closing markers, which
  // otherwise leaks a literal "**" onto the slide. Sweep whatever is left.
  t = t.replace(/\*{1,3}/g, "").replace(/(^|\s)_(?=\S)/g, "$1").replace(/`/g, "")
  return t
}

/** Hard truncation so nothing ever runs off a 1080p slide. */
const clip = (s: string, n: number) => (s.length <= n ? s : s.slice(0, n - 1).replace(/\s\S*$/, "") + "…")

const CSS = `
