function renderSlideBody(s: Slide): string {
  const p: string[] = []
  const kick = s.kicker ? (s.cont ? `${s.kicker} - continued` : s.kicker) : ""
  if (kick) p.push(`<div class="kicker ${s.kickerTone}">${esc(clip(kick, 62))}</div>`)
  p.push(s.big ? `<h1>${inline(clip(s.title, 84))}</h1>` : `<h2>${inline(clip(s.title, 110))}</h2>`)
  if (s.lede) p.push(`<div class="lede">${inline(clip(s.lede, 330))}</div>`)
  for (const pt of s.points) {
    p.push(`<div class="pt"><div class="n">${pt.n}</div><div class="b">` +
      `<div class="t">${inline(clip(pt.t, 92))}</div>` +
      (pt.s ? `<div class="s">${inline(clip(pt.s, 240))}</div>` : ``) +
      `</div></div>`)
  }
  if (s.bullets.length) {
    p.push(`<ul>` + s.bullets.map((b) => `<li>${inline(clip(b, 190))}</li>`).join("") + `</ul>`)
  }
  if (s.code) {
    p.push(`<pre>${s.code.lines.map((l) => esc(clip(l.replace(/\t/g, "  "), 92))).join("\n")}</pre>`)
  }
  if (s.table) {
    p.push(`<table><tr>` + s.table.head.map((h) => `<th>${inline(clip(h, 26))}</th>`).join("") + `</tr>` +
      s.table.rows.map((r) => `<tr>` + r.map((c) => `<td>${inline(clip(c, 74))}</td>`).join("") + `</tr>`).join("") +
      `</table>`)
  }
  if (s.manifest) {
    p.push(`<div class="man">` + s.manifest.map(([k, v]) =>
      `<div class="r"><div class="k">${esc(k)}</div><div class="v">${esc(clip(v || "-", 96))}</div></div>`).join("") + `</div>`)
  }
  return p.join("\n    ")
}

function renderDeck(slides: Slide[], voice: string, docTitle: string, officer: Officer): string {
  const date = new Date().toLocaleDateString("en-GB", { weekday: "long", day: "numeric", month: "long", year: "numeric" })
  const body = slides.map((s, i) => {
    const vo = esc(s.narration).replace(/\n/g, " ")
    const extra = i === 0 ? `\n    <div class="foot">${esc(date)}</div>` : ``
    const stamp = i === slides.length - 1 ? `\n    <div class="stamp">${esc(officer.toUpperCase())}</div>` : ``
    return `<div class="slide" data-slide="${i}" data-voice="${esc(voice)}" data-voiceover="${vo}">\n  <div class="slide-inner">\n    ${renderSlideBody(s)}${extra}${stamp}\n  </div>\n</div>`
  }).join("\n\n")

  return `<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>${esc(docTitle)}</title>
<style>${CSS}</style>
</head>
<body>

${body}

<script>
(function () {
  var slides = document.querySelectorAll('.slide'); var i = 0;
  function show(n) { i = Math.max(0, Math.min(slides.length - 1, n));
    slides.forEach(function (el, idx) { el.classList.toggle('active', idx === i); }); }
  document.addEventListener('keydown', function (e) {
    if (e.key === 'ArrowRight' || e.key === ' ') show(i + 1);
    if (e.key === 'ArrowLeft') show(i - 1); });
  function fromHash() { var m = (location.hash.match(/slide=(\\d+)/) || [])[1];
    show(m == null ? 0 : +m); }
  window.addEventListener('hashchange', fromHash);
  fromHash();
})();
</script>
</body>
</html>
`
}

// =================================================================== VALUE
// The value deck. 8DO owns everything below this line except the content
// model, which is 8PO's (see THE SEAM).
//
// WHY IT EXISTS. The extractive deck above renders whatever shape the response
// happens to have. When the response is an engineering response, the deck is an
// engineering deck: every headline says "Update", the body carries mechanism,
// and the colour is positional so a security finding renders reassuring green.
// James's verdict, 2026-08-09: "too technical".
//
// The fix is not better extraction. It is a FIXED SPINE of eight slides with
// WRITTEN narration. A fixed shape means the deck is the same object every run,
// so it is scannable by memory rather than by reading; it makes an absent field
// LOUD instead of invisible; and it lets narration carry real connective tissue,
// because slide N always knows what slide N+1 is going to say.
//
// Nothing here invents. Every field is nullable and an absent field renders as
// "Not stated" in amber. An empty slot is a true signal about the run.
// ------------------------------------------------------------------------

/**
 * THE SEAM (8DO consumes, 8PO supplies).
 *
 * If `~/.claude/bin/lib/session-value.ts` exists and exports
 * `extractSessionValue(src: string): SessionValue | Promise<SessionValue>`,
 * it owns the content. Otherwise the conservative fallback below runs, which
 * only ever LIFTS text verbatim from the response and never computes a number.
 *
 * Every field is nullable. A partial object is safe: `normaliseValue` fills the
 * gaps with null so a missing key can never reach a slide as "undefined".
 */
export type RegressionState = "none" | "found" | "unverified"
export interface Improvement { metric: string; before: string | null; after: string | null }
export interface Remaining { text: string; done?: boolean }
export interface SessionValue {
  headline: string | null                          // the value claim, <= 8 words
  value: string | null                             // what is now true that was not
  jtbd: string | null                              // the job this run moved
  skill: string | null                             // capability gained, permanent
  regression: { state: RegressionState; note: string | null }
  learned: string | null
  improvement: Improvement[]                       // measured, never computed
  goal: string | null
  remaining: Remaining[]
  evidence: { label: string; value: string }[]     // verbatim only
  ask: string | null                               // the one decision for James
}

const VALUE_MODULE = join(HOME, ".claude/bin/lib/session-value.ts")

const str = (x: unknown): string | null => {
  if (typeof x !== "string") return null
  const t = x.trim().replace(/\s+/g, " ")
  return t.length >= 2 ? t : null
}

/** Contract guard: any shape in, a complete SessionValue out. Never throws. */
function normaliseValue(raw: any): SessionValue {
  const r = raw && typeof raw === "object" ? raw : {}
  const state = ["none", "found", "unverified"].includes(r?.regression?.state)
    ? (r.regression.state as RegressionState) : "unverified"
  return {
    headline: str(r.headline),
    value: str(r.value),
    jtbd: str(r.jtbd),
    skill: str(r.skill),
    regression: { state, note: str(r?.regression?.note) },
    learned: str(r.learned),
    improvement: Array.isArray(r.improvement)
      ? r.improvement.filter((i: any) => str(i?.metric))
        .map((i: any) => ({ metric: str(i.metric)!, before: str(i.before), after: str(i.after) }))
      : [],
    goal: str(r.goal),
    remaining: Array.isArray(r.remaining)
      ? r.remaining.filter((x: any) => str(x?.text ?? x))
        .map((x: any) => ({ text: str(x?.text ?? x)!, done: !!x?.done }))
      : [],
    evidence: Array.isArray(r.evidence)
      ? r.evidence.filter((e: any) => str(e?.label) && str(e?.value))
        .map((e: any) => ({ label: str(e.label)!, value: str(e.value)! }))
      : [],
    ask: str(r.ask),
  }
}

async function loadSessionValue(src: string): Promise<{ v: SessionValue; from: string }> {
  if (existsSync(VALUE_MODULE)) {
    try {
      const mod: any = await import(VALUE_MODULE)
      const fn = mod.extractSessionValue ?? mod.default
      if (typeof fn === "function") return { v: normaliseValue(await fn(src)), from: "session-value.ts" }
      log("value module has no extractSessionValue export - using fallback")
    } catch (e: any) {
      log(`value module threw, using fallback: ${e?.message || e}`)
    }
  }
  return { v: normaliseValue(fallbackValue(src)), from: "fallback (8PO module absent)" }
}

// -------------------------------------------------- conservative fallback
/** Strip inline markdown. Removes, never rewrites. */
function plain(s: string): string {
  return s.replace(/`([^`]*)`/g, "$1").replace(/\*\*([^*]+)\*\*/g, "$1")
    .replace(/\[([^\]]+)\]\([^)]*\)/g, "$1").replace(/[*_]/g, "")
    .replace(/\s*[—–]\s*/g, " - ").replace(/\s+/g, " ").trim().replace(/[:;,]+$/, "")
}

/**
 * Find `Label: value` on its own line. Markdown is stripped BEFORE matching,
 * because house style writes `**Learned:**` with the colon inside the bold
 * markers and a pattern anchored on the markers misses it every time.
 */
function labelled(src: string, labels: string[]): string | null {
  const re = new RegExp(`^(?:${labels.join("|")})\\s*[:\\-]\\s+(.+)$`, "i")
  for (const raw of src.split("\n")) {
    const ln = plain(raw.replace(/^\s{0,3}(?:[-*+]|\d+[.)])\s+/, "")).trim()
    const m = ln.match(re)
    if (m) { const t = str(m[1]); if (t) return t }
  }
  return null
}

/** Bullets that follow a heading or bold lead matching one of `labels`. */
function sectionItems(src: string, labels: string[], max: number): string[] {
  const re = new RegExp(`^\\s*(?:#{1,4}\\s*|\\**)(?:${labels.join("|")})[^\\n]*$`, "im")
  const m = src.match(re)
  if (!m) return []
  const after = src.slice((m.index ?? 0) + m[0].length).split("\n")
  const out: string[] = []
  for (const ln of after) {
    if (/^\s*#{1,4}\s/.test(ln)) break
    const li = ln.match(/^\s{0,3}(?:[-*+]|\d+[.)])\s+(?:\[[ xX]\]\s*)?(.+)$/)
    if (li) { const t = str(plain(li[1])); if (t) out.push(t) }
    else if (out.length && /^\s*$/.test(ln)) continue
    else if (out.length) break
  }
  return out.slice(0, max)
}

/**
 * Fills only what the response literally says. No arithmetic, no inference of a
 * clean bill of health: a regression is "unverified" unless the response states
 * otherwise, because "tests passed" is not the same sentence as "nothing broke".
 */
function fallbackValue(src: string): SessionValue {
  const completed = extractCompleted(src)
  const improvement: Improvement[] = []
  const seen = new Set<string>()
  const push = (metric: string, before: string | null, after: string | null) => {
    const m = str(plain(metric))
    if (!m || seen.has(m.toLowerCase()) || improvement.length >= 3) return
    seen.add(m.toLowerCase()); improvement.push({ metric: m, before, after })
  }
  // Only forms where BOTH sides are literally present in the text.
  for (const m of src.matchAll(/([A-Za-z][\w %.\-/()]{2,42}?)\s+(?:went\s+)?from\s+([\d][\w.%,:/]*)\s+to\s+([\d][\w.%,:/]*)/gi)) {
    push(m[1], m[2], m[3])
  }
  for (const m of src.matchAll(/^\s*(?:[-*+]\s*)?\**([A-Za-z][\w %.\-/()]{2,42}?)\**\s*[:|]\s*([\d][\w.%,:/]*)\s*(?:->|→|=>)\s*([\d][\w.%,:/]*)/gim)) {
    push(m[1], m[2], m[3])
  }

  const evidence: { label: string; value: string }[] = []
  for (const k of ["VALIDATE", "COMMIT", "PUSHED", "PR"]) {
    const m = src.match(new RegExp(`^\\s{0,6}${k}:\\s*(.+)$`, "m"))
    const v = m ? str(plain(m[1])) : null
    if (v && !/^(no |none|direct push|deploy pending)/i.test(v)) evidence.push({ label: k, value: v })
  }
  const tests = src.match(/\b([\d,]{1,7})\s+tests?\s+pass(?:ing|ed)?\b/i)
  if (tests) evidence.unshift({ label: "TESTS", value: `${tests[1]} passing` })

  const regFound = /\bregressions?\s+(?:were\s+)?(?:found|introduced|detected)\b|\bbroke\s+(?:an?\s+)?existing\b/i.test(src)
  const regNone = /\bno\s+regressions?\b|\bregressions?\s*[:=]\s*(?:no|none)\b|\bnothing\s+(?:that worked\s+)?(?:before\s+)?broke\b/i.test(src)

  let ask = labelled(src, ["The ask", "Ask", "Decision needed", "Your call", "Needs your decision"])
  if (!ask) {
    const qs = src.replace(/```[\s\S]*?```/g, " ").match(/[^.!?\n]{12,160}\?/g)
    if (qs) ask = str(plain(qs[qs.length - 1]))
  }

  return {
    headline: str(plain(completed || "")) ,
    value: labelled(src, ["Value", "What changed for you", "Impact"]) ?? str(plain(completed || "")),
    jtbd: labelled(src, ["JTBD", "Job to be done", "The job", "Job"]),
    skill: labelled(src, ["Skill", "Skill gained", "Capability", "Capability gained"]),
    regression: {
      state: regFound ? "found" : regNone ? "none" : "unverified",
      note: labelled(src, ["Regression", "Regressions"]),
    },
    learned: labelled(src, ["Learned", "What we learned", "Lesson", "Lesson learned"]),
    improvement,
    goal: labelled(src, ["Goal", "The goal", "Target"]),
    remaining: [
      ...sectionItems(src, ["What is left", "What's left", "Remaining", "Outstanding", "Still open", "Next"], 4)
        .map((t) => ({ text: t, done: false })),
      ...(src.match(/^\s*[-*+]\s*\[ \]\s*(.+)$/gim) || []).slice(0, 4)
        .map((l) => ({ text: plain(l.replace(/^\s*[-*+]\s*\[ \]\s*/, "")), done: false })),
    ].slice(0, 4),
    evidence: evidence.slice(0, 3),
    ask,
  }
}

// ------------------------------------------------------------- hard caps
/**
 * Enforced in code, not trusted to the input. The brief is "simple": James is
 * AuDHD and runs twelve projects, so a dense deck is a wall he bounces off.
 *
 * EIGHT slides, always. There is no overflow path in this renderer - the
 * function that splits a full slide into "continued" simply does not exist
 * here, so a deck of nine is unreachable rather than merely discouraged.
 */
const CAP = {
  slides: 8,
  headlineWords: 15,
  lineWords: 15,
  lines: 3,
  slideWords: 42,
  narrationWords: 46,
  askWords: 20,
  ladderRows: 4,
  stats: 3,
  statLabelWords: 5,
}

const words = (s: string) => (s.trim() ? s.trim().split(/\s+/).length : 0)

/** Words that cannot be the last word on a slide. They promise a next word. */
const DANGLERS = new Set(("a an the of for on in to and or with without by at from that which is are was were " +
  "into onto over under after before while as but so than then its their his her our your my this these those " +
  "no not per via up out off about between across through during since until").split(" "))

/**
 * Shorten by REMOVING, never by rewriting, and never with an ellipsis. An
 * ellipsis on a slide is an open loop, and an open loop is exactly the thing an
 * ADHD reader pays for twice. Prefer whole sentences; then a whole clause.
 */
function tighten(s: string, maxWords: number): string {
  const t = s.trim().replace(/\s+/g, " ")
  if (words(t) <= maxWords) return t
  const sentences = t.match(/[^.!?]+[.!?]+/g) || []
  let acc = ""
  for (const sen of sentences) {
    if (words(acc + sen) > maxWords) break
    acc += sen
  }
  if (words(acc) >= Math.min(4, maxWords)) return acc.trim()
  const cut = t.split(/\s+/).slice(0, maxWords).join(" ")
  // Prefer ending on a clause boundary. "Telegram autonomy merged, allowlist
  // verified" is a headline; "...verified, a callback hole" is a dangling limb.
  const brk = Math.max(cut.lastIndexOf(","), cut.lastIndexOf(";"), cut.lastIndexOf(":"))
  const clause = brk > 0 ? cut.slice(0, brk) : ""
  const base = words(clause) >= 4 ? clause : cut
  // And never end on a word that is holding the door open for the next one.
  const w = base.replace(/[,;:]+$/, "").split(" ")
  while (w.length > 4 && DANGLERS.has(w[w.length - 1].toLowerCase().replace(/[^a-z-]/g, ""))) w.pop()
  return w.join(" ").replace(/[\s,;:\u00b7\-]+$/, "")
}

// ------------------------------------------------------------ the spine
type VKind = "title" | "claim" | "stat" | "verdict" | "ladder" | "ask"
type Tone = "" | "good" | "watch" | "alert"

interface VSlide {
  kind: VKind
  act: 1 | 2 | 3
  kicker: string
  headline: string
  unsetHeadline?: boolean
  lines: { text: string; unset?: boolean }[]
  tone: Tone
  stats?: { big: string; lab: string; sub?: string; tone: Tone }[]
  verdict?: { word: string; why: string }
  rows?: { text: string; done: boolean }[]
  record?: [string, string][]
  narration: string
}

const NOT_STATED = "Not stated"

/** A support line, or the honest absence of one. Never a guess. */
const line = (t: string | null, fallback: string): { text: string; unset?: boolean } =>
  t ? { text: tighten(t, CAP.lineWords) } : { text: fallback, unset: true }

/** Drop whole trailing lines rather than truncate one. Silence beats an ellipsis. */
function fitSlide(s: VSlide): VSlide {
  let total = words(s.headline)
  const kept: typeof s.lines = []
  for (const l of s.lines) {
    if (kept.length >= CAP.lines) break
    if (total + words(l.text) > CAP.slideWords && kept.length) break
    kept.push(l); total += words(l.text)
  }
  s.lines = kept
  if (s.kind !== "ask") s.headline = tighten(s.headline, CAP.headlineWords)
  return s
}

/**
 * NARRATION. Written, not extracted, and that is the whole point: James listens
 * more than he watches. Seven fixed HINGES carry him slide to slide - "That is
 * worth a number", "Now the part that compounds", "So here is what improved" -
 * which is only writable because the spine guarantees what comes next.
 *
 * Warm, brief, no jokes, per the Voice Experience Contract. Deterministic: the
 * same SessionValue produces the same sentences every time.
 */
function narrate(raw: string): string {
  const t = speakable(raw)
  const w = t.split(/\s+/)
  if (w.length <= CAP.narrationWords) return t
  const cut = w.slice(0, CAP.narrationWords).join(" ")
  const stop = Math.max(cut.lastIndexOf(". "), cut.lastIndexOf("? "))
  return stop > cut.length * 0.4 ? cut.slice(0, stop + 1).trim() : cut.replace(/[,;:]+$/, "") + "."
}

const ACT_NAME: Record<1 | 2 | 3, string> = {
  1: "Act one - what changed for you",
  2: "Act two - what the system learned",
  3: "Act three - where this leaves us",
}

function buildValueSpine(v: SessionValue, narratorLabel: string, officer: Officer): VSlide[] {
  const s: VSlide[] = []
  const n = (x: string) => x.replace(/\s+/g, " ").trim()
  // A spoken clause has a shorter comfortable length than a written one. Fields
  // are tightened before they enter a sentence, not after the sentence is built,
  // so the hinge phrase is never the thing that gets cut.
  const sp = (x: string | null, max = 24) => (x ? tighten(x, max) : "")

  // 1. TITLE - the verdict card. One claim, one line, nothing else.
  const headline = v.headline ?? v.value ?? null
  s.push(fitSlide({
    kind: "title", act: 1, kicker: "8GI - Session value",
    headline: headline ?? "Nothing was claimed",
    unsetHeadline: !headline,
    // The title card carries a claim and nothing else. When the value IS the
    // headline there is no second line to write, and inventing an absence
    // ("No value was stated") under a stated value would be a lie on slide one.
    lines: headline
      ? (v.value && v.value !== headline ? [line(v.value, "")] : [])
      : [{ text: "No value was stated for this run.", unset: true }],
    tone: headline ? "" : "watch",
    narration: narrate(headline
      ? `${narratorLabel} here. ${sp(headline, 20)}.`
      : `${narratorLabel} here. This run did not state what it changed for you, so read the rest as work without a claim.`),
  }))

  // 2. THE JOB - value framed as the job it moved, not the code it touched.
  s.push(fitSlide({
    kind: "claim", act: 1, kicker: ACT_NAME[1],
    headline: v.jtbd ?? "The job was not stated",
    unsetHeadline: !v.jtbd,
    // Three states, not two: a different outcome gets a line, an outcome the
    // title card already made gets silence, and a missing one gets the amber
    // "not stated". Reusing "not stated" for the second case would print a
    // falsehood underneath a value that is on screen one slide earlier.
    lines: v.value && v.value !== headline ? [line(v.value, "")]
      : v.value ? []
        : [{ text: "No outcome was stated.", unset: true }],
    tone: v.jtbd ? "" : "watch",
    narration: narrate(v.jtbd
      ? `Start with the job this moved. ${sp(v.jtbd)}. ${sp(v.value)}`
      : `Start with the job. It was not stated, so nobody can say which of your twelve projects this run served.`),
  }))

  // 3. THE NUMBER - the only place a number gets big, so a number means something.
  const imp = v.improvement.slice(0, CAP.stats)
  const spoken = imp.slice(0, 2).map((i) => i.before && i.after
    ? `${i.metric} went from ${i.before} to ${i.after}`
    : `${i.metric} is now ${i.after ?? i.before ?? "unstated"}`).join(", and ")
  s.push(fitSlide({
    kind: "stat", act: 1, kicker: ACT_NAME[1],
    headline: imp.length ? "Quantified" : "Not measured",
    unsetHeadline: !imp.length,
    lines: imp.length ? [] : [{ text: "This run produced no measured improvement.", unset: true }],
    tone: imp.length ? "good" : "watch",
    // When nothing was measured there is no stat block. A giant "NOT MEASURED"
    // above a line that says the same thing is shouting, and the amber headline
    // has already carried it.
    stats: imp.length
      ? imp.map((i) => ({
        big: i.after ?? i.before ?? NOT_STATED,
        lab: tighten(i.metric, CAP.statLabelWords),
        sub: i.before && i.after ? `from ${i.before}` : undefined,
        tone: "good" as Tone,
      }))
      : undefined,
    narration: narrate(imp.length
      ? `That is worth a number. ${spoken}.`
      : `That is worth a number, and this run does not have one. Nothing was measured, so the improvement cannot be proven. That is the gap to close next run.`),
  }))

  // 4. WHAT WE LEARNED - act two opens on the compounding part.
  s.push(fitSlide({
    kind: "claim", act: 2, kicker: ACT_NAME[2],
    headline: v.learned ?? "Nothing was recorded as learned",
    unsetHeadline: !v.learned,
    lines: [],
    tone: v.learned ? "" : "watch",
    narration: narrate(v.learned
      ? `Now the part that compounds. What we learned. ${sp(v.learned, 26)}.`
      : `Now the part that compounds, except this run recorded nothing learned. Work without a lesson is work you can be asked to do again.`),
  }))

  // 5. THE SKILL - the hinge the brief asked for, in the exact place it belongs:
  //    learning on the left, the permanent capability it bought on the right.
  s.push(fitSlide({
    kind: "claim", act: 2, kicker: ACT_NAME[2],
    headline: v.skill ?? "No new capability",
    unsetHeadline: !v.skill,
    lines: [],
    tone: v.skill ? "good" : "watch",
    narration: narrate(v.skill
      ? `So here is what improved permanently. ${sp(v.skill, 26)}.`
      : `So here is what improved permanently. Nothing did. The system is the same size tonight as it was this morning.`),
  }))

  // 6. REGRESSION - the one slide where colour is a fact, and it is always
  //    paired with the word, so the deck reads correctly in greyscale.
  const reg = v.regression.state
  const vword = reg === "none" ? "NO REGRESSION" : reg === "found" ? "REGRESSION FOUND" : "NOT VERIFIED"
  s.push(fitSlide({
    kind: "verdict", act: 2, kicker: ACT_NAME[2],
    headline: vword,
    lines: [line(v.regression.note, reg === "unverified"
      ? "Nobody checked whether something that worked before still works."
      : "No detail stated.")],
    tone: reg === "none" ? "good" : reg === "found" ? "alert" : "watch",
    verdict: { word: vword, why: v.regression.note ?? "" },
    narration: narrate(
      reg === "none" ? `On regressions. Nothing that worked before stopped working, and that was checked. ${sp(v.regression.note, 18)}`
        : reg === "found" ? `On regressions. Something that worked before is broken now. ${sp(v.regression.note, 22) || "The detail is on screen."}`
          : `On regressions. This was not verified, so treat it as unknown rather than as fine.`),
  }))

  // 7. THE LADDER - goal on top, what remains under it. Act three.
  const rows = v.remaining.slice(0, CAP.ladderRows).map((r) => ({ text: tighten(r.text, CAP.lineWords), done: !!r.done }))
  const left = rows.filter((r) => !r.done).length
  s.push(fitSlide({
    kind: "ladder", act: 3, kicker: ACT_NAME[3],
    headline: v.goal ?? "No goal stated",
    unsetHeadline: !v.goal,
    lines: rows.length ? [] : [{ text: "Nothing was listed as remaining.", unset: true }],
    tone: v.goal ? "" : "watch",
    rows,
    narration: narrate(v.goal
      ? `Where that leaves the goal. ${sp(v.goal, 20)}. ${left ? `${left} thing${left === 1 ? "" : "s"} remain. ${rows.find((r) => !r.done)?.text ?? ""}` : "Nothing was listed as remaining."}`
      : `Where that leaves the goal. No goal was stated, so there is no way to tell how close this run got. ${left ? `${left} thing${left === 1 ? "" : "s"} are still listed as remaining.` : ""}`),
  }))

  // 8. THE ASK - the only slide with a job: make James do one thing. It is last
  //    because the last frame is the one that stays on screen after the audio.
  // Two pieces of evidence, chosen by what actually proves a claim rather than
  // by the order they happened to appear in the sign-off.
  const RANK = ["TESTS", "VALIDATE", "COMMIT", "PUSHED", "PR", "ISSUE", "VISUAL"]
  const rank = (l: string) => { const i = RANK.indexOf(l.toUpperCase()); return i < 0 ? RANK.length : i }
  const record: [string, string][] = [...v.evidence]
    .sort((a, b) => rank(a.label) - rank(b.label)).slice(0, 2)
    .map((e) => [e.label, e.value] as [string, string])
  record.push(["WORKED BY", officer === "James" ? "AI James" : officer])
  s.push(fitSlide({
    // The ask gets a longer allowance than any other headline and steps the type
    // down instead. Cutting "restart it, or leave it until you are done" at the
    // comma turns a choice into an instruction, which is a truncation that
    // changes the decision. The type may shrink; the question may not.
    kind: "ask", act: 3, kicker: "The ask",
    headline: v.ask ? tighten(v.ask, CAP.askWords) : "Nothing needs you",
    unsetHeadline: !v.ask,
    lines: [line(v.ask ? "Reply with your call and nothing moves until you do." : null,
      "No decision is waiting on you. This one is closed.")],
    tone: v.ask ? "watch" : "",
    record,
    narration: narrate(v.ask
      ? `One decision from you. ${sp(v.ask, 26)} Nothing moves until you answer.`
      : `And nothing needs a decision from you. This one is closed.`),
  }))

  return s.slice(0, CAP.slides).map((x) => ({ ...x, headline: n(x.headline) }))
}

// -------------------------------------------------------------- value css
/**
 * COLOUR IS SEMANTIC, NEVER POSITIONAL.
 *
 * The old deck coloured a kicker by `sectionIdx % 4`, so green meant "you are on
 * an even section", which is how a slide about a security hole rendered
 * reassuring. Here the default is NEUTRAL. Colour appears only when it carries a
 * fact, and then it carries exactly one:
 *
 *   good  #2ECC8F  a verified improvement, or a checked no-regression
 *   watch #F2B43C  not stated, not measured, not verified, still remaining
 *   alert #F2704C  something that worked before is broken
 *
 * Every coloured state is PAIRED WITH ITS WORD (WCAG 1.4.1), so the deck reads
 * correctly in greyscale and for a colour-blind viewer. Hues 270-350 are banned
 * by BRAND.md and none appear here. Body copy is #B9B9C4 on #08080E, ~9.7:1.
 */
const VALUE_CSS = `
